WECOM_CORPID=your_corpid_here
WECOM_SECRET=your_secret_here
WECOM_TOKEN=your_token_here
WECOM_AES_KEY=your_aes_key_here
WECOM_AGENT_ID=1000002
REDIS_URL=redis://localhost:6379/0
QUEUE_KEY=wecom:msg:stream
APP_PORT=8000

# Local desktop MVP: no callback credentials or Redis are required in dry-run.
DRY_RUN=true
INBOX_BACKEND=cli
# Personal account dry-run: use --personal, or set INBOX_BACKEND=personal.
# Keep Ri's unfiltered chat-history panel open. No server user_id is inferred.
PERSONAL_CONTACT_NAME=Ri
PERSONAL_LLM_TEMPLATE_NAME=personal_reply.txt
# Personal WeChat via Tencent's official iLink Bot API: use --wechat, or set
# INBOX_BACKEND=wechat_ilink. Reply identity is the iLink bot, not your account.
# 1) run: python agent_loop.py --wechat-login and scan the QR with your WeChat
# 2) ask the peer to message the bot once, then copy their ID from the
#    "wechat_ilink_unlisted_sender" log line into WECHAT_ILINK_ALLOWED_USER
# 3) run: python agent_loop.py --wechat (add --live only after review)
WECHAT_ILINK_ALLOWED_USER=
WECHAT_ILINK_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_ILINK_TOKEN_PATH=.wechat_ilink.json
WECHAT_ILINK_STATE_PATH=.wechat_ilink_state.json
WECHAT_LLM_TEMPLATE_NAME=wechat_reply.txt
# Personal WeChat via OCR of the desktop window: use --wechat-ocr, or set
# INBOX_BACKEND=wechat_ocr. The reply identity is your own WeChat account in
# the already-open verified single chat. Requires macOS screen-recording
# permission for the terminal and accessibility permission for keystrokes.
# Keep the target single chat open and visible in the main WeChat window.
WECHAT_OCR_CONTACT=Ri
WECHAT_OCR_TEMPLATE_NAME=wechat_ocr_reply.txt
# wx history reads config.json in this directory. Verify it belongs to wx2.
# Keep false until the wx2 account/data-directory mapping is actually checked.
WX_CLI_WORKDIR=.
WX_CLI_ACCOUNT_VERIFIED=false
# Copy verified CLI single-chat/user IDs; do not guess from display names.
INBOX_CHAT_ID=
INBOX_SENDER_ID=
INBOX_VERIFIED_SINGLE_CHAT=false
# CLI timestamps have no timezone; verify this interpretation for your account.
INBOX_TIMEZONE=Asia/Shanghai
ALLOWED_USER_ID=LiChengYun
POLL_INTERVAL_SECONDS=2
DEDUP_BUCKET_SECONDS=5
DB_URL=sqlite:///./agent.db
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPLATE_NAME=desktop_reply.txt
