WECOM_CORPID=your_corpid_here
WECOM_SECRET=your_secret_here
WECOM_TOKEN=your_token_here
WECOM_AES_KEY=your_aes_key_here
WECOM_AGENT_ID=1000002
REDIS_URL=redis://localhost:6379/0
QUEUE_KEY=wecom:msg:stream
APP_PORT=8000

# Local desktop MVP: no callback credentials or Redis are required in dry-run.
DRY_RUN=true
INBOX_BACKEND=cli
# Personal account dry-run: use --personal, or set INBOX_BACKEND=personal.
# Keep Ri's unfiltered chat-history panel open. No server user_id is inferred.
PERSONAL_CONTACT_NAME=Ri
PERSONAL_LLM_TEMPLATE_NAME=personal_reply.txt
# Copy verified CLI single-chat/user IDs; do not guess from display names.
INBOX_CHAT_ID=
INBOX_SENDER_ID=
INBOX_VERIFIED_SINGLE_CHAT=false
# CLI timestamps have no timezone; verify this interpretation for your account.
INBOX_TIMEZONE=Asia/Shanghai
ALLOWED_USER_ID=LiChengYun
POLL_INTERVAL_SECONDS=2
DEDUP_BUCKET_SECONDS=5
DB_URL=sqlite:///./agent.db
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPLATE_NAME=desktop_reply.txt
